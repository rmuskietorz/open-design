# Image tag (lokal gebaut). Bei Push in eigene Registry hier eintragen.
OPEN_DESIGN_IMAGE=open-design:claude-cli

# Claude CLI Version, die ins Image installiert wird.
# "latest" oder konkrete Version, z.B. 1.0.45
CLAUDE_CLI_VERSION=latest

# Host-Port (Standard nur 127.0.0.1). Fuer Reverse Proxy in Ruhe lassen.
OPEN_DESIGN_PORT=7456
OPEN_DESIGN_BIND=127.0.0.1

# Browser-Origins, die /api aufrufen duerfen, wenn du hinter Domain/Proxy liegst.
# Komma-separiert: https://design.example.com,https://design.intern
OPEN_DESIGN_ALLOWED_ORIGINS=

# Container-Memory. Mit Claude-CLI-Spawn realistisch 1-2 GiB.
OPEN_DESIGN_MEM_LIMIT=2g
NODE_OPTIONS=--max-old-space-size=1024

# WICHTIG: ANTHROPIC_API_KEY hier NICHT setzen.
# Claude CLI laeuft ueber den Subscription-OAuth-Token (aus `claude setup-token`).
# API-Key wuerde Verbrauch auf API-Billing umleiten statt aufs Abo.

# Subscription-OAuth-Token. Wird vom od-admin-Login-Flow automatisch hier
# eingetragen (Format sk-ant-oat01-...). Leer lassen, bis der Login lief.
# CLAUDE_CODE_OAUTH_TOKEN=
